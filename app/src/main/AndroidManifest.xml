<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Files - tracks and offline map regions alike - come through SAF, which grants access
      to exactly the one file the user picked. There is no storage permission and never
      will be.

      What recording costs, and nothing beyond it:
        ACCESS_FINE_LOCATION       the only way to sample a position.
        ACCESS_COARSE_LOCATION     not wanted. Android 12+ ignores a fine request that
                                   does not also name coarse, so it has to be declared.
                                   The app refuses to record on an approximate-only grant
                                   rather than produce numbers that look real and are not.
        FOREGROUND_SERVICE(_LOCATION)  sampling with the screen off, visibly.
        POST_NOTIFICATIONS         so the recording notification is actually seen.
                                   Recording still works if this is refused.
      All four are requested on the tap that starts a recording, not at launch, and every
      other feature works without them.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Network access is denied structurally, not by vigilance: the manifest merger folds in
      every dependency's permissions, so a library can add INTERNET without anyone writing
      it. tools:node="remove" strips it back out.

      This is no longer theoretical. MapLibre's own manifest declares all three of these,
      and its ConnectivityReceiver calls getActiveNetworkInfo() unguarded - which throws
      without ACCESS_NETWORK_STATE. GpxApplication answers that by telling MapLibre it is
      offline before any map exists, which short-circuits the call it would otherwise make.

      Nothing here relies on anyone remembering to check: CheckNoNetworkPermissions in
      app/build.gradle.kts transforms the merged manifest and fails the build if any of the
      three survives into it.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- Implied by the ACCESS_WIFI_STATE that MapLibre declares and this app removes. -->
    <uses-feature android:name="android.hardware.wifi" tools:node="remove" />

    <!-- GPS is required for the recorder, but the viewer works on any device. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".GpxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GpxViewer">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|smallestScreenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GpxViewer"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for files a provider correctly types as GPX or XML. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>

            <!--
              Most file managers hand .gpx over as an untyped stream, so match on the
              extension as well. Deliberately not matching application/octet-stream
              without the extension - that would put this app in the "Open with" sheet
              for every unrecognised file on the device.
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\.gpx" />
            </intent-filter>

            <!-- Share sheet target. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
