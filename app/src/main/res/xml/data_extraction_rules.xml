<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is off (android:allowBackup="false"), so nothing here is exercised today. It
  exists to state the intent: the tracks database holds SAF URIs that are only valid on
  the device that granted them, so it must never be copied off the device. Once recording
  lands the `file` domain holds the user's own recordings, which is a stronger reason
  again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
