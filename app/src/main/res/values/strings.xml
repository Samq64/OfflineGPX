    <string name="settings_units">Units</string>
    <string name="settings_units_explanation">Changes how numbers are shown. Files stay in metres either way, so switching back and forth never alters a track.</string>
    <string name="settings_units_metric">Metric</string>
    <string name="settings_units_imperial">Imperial</string>

    <string name="settings_accuracy">Accuracy limit</string>
    <string name="settings_accuracy_explanation">Fixes less certain than this are ignored. Lower keeps out the wandering a phone does when it can\'t see the sky; too low and a wooded valley records nothing.</string>

    <string name="settings_displacement">Minimum movement</string>
    <string name="settings_displacement_explanation">How far a fix must move before it counts as travel. This is what stops a stationary phone from recording a ride. Lower it if real rides come out short.</string>
    <string name="settings_displacement_off">Off</string>

    <string name="settings_recording_applies_next">Both are read when a recording starts, so changing them won\'t affect one already running.</string>
    <string name="settings_reset">Reset to defaults</string>

    <string name="settings_section_maps">Offline maps</string>
    <string name="settings_maps_explanation">This app has no internet access, so maps can\'t be downloaded here. Get a .pmtiles file on another device and open it below. Everything works without one — routes are simply drawn on a plain background.</string>
