    <string name="map_open_list">Tracks</string>
    <string name="map_description">Routes. Tap one to open it. Drag to move, pinch to zoom; pinch all the way out to see everything.</string>
    <string name="map_empty_title">Nothing to show</string>
    <string name="map_empty_body">Record a ride or a walk, or open a .gpx file from the track list.</string>
